<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<add key="GitHub-ztepsic" value="https://nuget.pkg.github.com/ztepsic/index.json" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="GitHub-ztepsic">
			<package pattern="*-alpha.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>